{
  "name": "golfinho",
  "version": "0.1.24",
  "private": true,
  "description": "Ambiente desktop para tarefas com agentes e branches Git",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/local-app.mjs dev",
    "build": "electron-vite build",
    "start": "node scripts/local-app.mjs preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "node node_modules/electron/install.js && electron-rebuild -f -w node-pty",
    "smoke": "node scripts/smoke.mjs",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.299",
    "@fontsource-variable/geist": "5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "6.8.10",
    "lucide-react": "1.57.0",
    "monaco-editor": "0.57.0",
    "node-pty": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "build": {
    "appId": "com.golfinho.app",
    "publish": [
      {
        "provider": "github",
        "owner": "Joaocstt",
        "repo": "golfinho"
      }
    ],
    "productName": "Golfinho",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "build",
        "to": "branding",
        "filter": [
          "icon.png",
          "icon.ico"
        ]
      }
    ],
    "npmRebuild": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "jsantana <jnc201820@gmail.com>",
      "syncDesktopName": true
    }
  },
  "homepage": "https://github.com/Joaocstt/golfinho",
  "author": {
    "name": "jsantana",
    "email": "jnc201820@gmail.com"
  },
  "desktopName": "golfinho.desktop"
}
